<Window x:Class="ItchyBackup.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:ItchyBackup.ViewModels"
        xmlns:models="clr-namespace:ItchyBackup.Models"
        Title="Itchy Backup" Width="1280" Height="820"
        MinWidth="1060" MinHeight="700"
        WindowStyle="None" AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="CenterScreen"
        Closing="Window_Closing">
  <Window.DataContext>
    <vm:MainViewModel/>
  </Window.DataContext>

  <Window.Resources>
    <Style x:Key="ShellCard" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource BgSecondary}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="6"/>
      <Setter Property="Padding" Value="16"/>
    </Style>

    <Style x:Key="SectionTitle" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
      <Setter Property="FontFamily" Value="Segoe UI"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <Style x:Key="FieldLabel" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource TextTertiary}"/>
      <Setter Property="FontFamily" Value="Segoe UI"/>
      <Setter Property="FontSize" Value="10"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Margin" Value="0,0,0,5"/>
    </Style>

    <Style x:Key="NavButton" TargetType="Button">
      <Setter Property="Height" Value="42"/>
      <Setter Property="Margin" Value="8,2"/>
      <Setter Property="Padding" Value="12,0"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Root" Background="{TemplateBinding Background}" CornerRadius="5">
              <ContentPresenter Margin="{TemplateBinding Padding}"
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Root" Property="Background" Value="{DynamicResource BgTertiary}"/>
                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Root" Property="Background" Value="{DynamicResource AccentSubtle}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="MiniButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
      <Setter Property="Padding" Value="9,5"/>
      <Setter Property="FontSize" Value="10"/>
      <Setter Property="Height" Value="28"/>
    </Style>

    <Style x:Key="IconWindowButton" TargetType="Button">
      <Setter Property="Width" Value="42"/>
      <Setter Property="Height" Value="46"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Root" Background="{TemplateBinding Background}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Root" Property="Background" Value="{DynamicResource BgTertiary}"/>
                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Border CornerRadius="8"
          Background="{DynamicResource BgPrimary}"
          BorderBrush="{DynamicResource WindowBorderBrush}"
          BorderThickness="1"
          ClipToBounds="True">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="46"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="28"/>
      </Grid.RowDefinitions>

      <!-- Window bar -->
      <Border Grid.Row="0"
              Background="{DynamicResource BgSecondary}"
              BorderBrush="{DynamicResource BorderBrush}"
              BorderThickness="0,0,0,1"
              MouseLeftButtonDown="TitleBar_MouseDown">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>

          <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="14,0" VerticalAlignment="Center">
            <Image Source="/Resources/Icons/app-emblem.png" Width="26" Height="26"
                   RenderOptions.BitmapScalingMode="HighQuality"/>
            <TextBlock Text="ITCHY BACKUP" Margin="9,0,0,0"
                       VerticalAlignment="Center" FontFamily="Segoe UI"
                       FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}"/>
          </StackPanel>

          <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
            <Border Background="{DynamicResource AccentSubtle}" CornerRadius="3" Padding="7,3">
              <TextBlock Text="v1.6.0" FontSize="9" FontFamily="Consolas"
                         Foreground="{DynamicResource AccentLight}"/>
            </Border>
            <TextBlock Text="Teknik servis yedekleme konsolu" Margin="10,0,0,0"
                       FontSize="10" Foreground="{DynamicResource TextTertiary}"
                       VerticalAlignment="Center"/>
          </StackPanel>

          <StackPanel Grid.Column="2" Orientation="Horizontal">
            <Button Style="{StaticResource IconWindowButton}" Click="ThemeToggle_Click" ToolTip="Temayı değiştir">
              <TextBlock Text="◐" FontSize="16"/>
            </Button>
            <Button Style="{StaticResource IconWindowButton}" Click="MinimizeBtn_Click" ToolTip="Küçült">
              <TextBlock Text="─" FontSize="14"/>
            </Button>
            <Button Style="{StaticResource IconWindowButton}" Click="MaximizeBtn_Click" ToolTip="Büyüt">
              <TextBlock Text="□" FontSize="14"/>
            </Button>
            <Button Style="{StaticResource IconWindowButton}" Click="CloseBtn_Click" ToolTip="Kapat">
              <TextBlock Text="×" FontSize="18"/>
            </Button>
          </StackPanel>
        </Grid>
      </Border>

      <Grid Grid.Row="1">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="220"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Grid.Column="0" Background="{DynamicResource BgSecondary}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="ÇALIŞMA ALANI" Margin="18,18,0,8"
                       FontSize="9" FontWeight="Bold" Foreground="{DynamicResource TextMuted}"/>

            <StackPanel Grid.Row="1">
              <Button Style="{StaticResource NavButton}" Command="{Binding OpenBackupCommand}">
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                  <Border Width="3" Height="22" CornerRadius="2" Background="{DynamicResource Accent}"
                          HorizontalAlignment="Left" Margin="-12,0,0,0">
                    <Border.Style>
                      <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers><DataTrigger Binding="{Binding IsPanelBackup}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                      </Style>
                    </Border.Style>
                  </Border>
                  <TextBlock Text="" FontFamily="Segoe MDL2 Assets" FontSize="15"/>
                  <TextBlock Grid.Column="1" Text="Yedekleme" FontSize="12" VerticalAlignment="Center"/>
                </Grid>
              </Button>
              <Button Style="{StaticResource NavButton}" Command="{Binding OpenRestoreCommand}">
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                  <Border Width="3" Height="22" CornerRadius="2" Background="{DynamicResource Accent}"
                          HorizontalAlignment="Left" Margin="-12,0,0,0">
                    <Border.Style>
                      <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers><DataTrigger Binding="{Binding IsPanelRestore}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                      </Style>
                    </Border.Style>
                  </Border>
                  <TextBlock Text="" FontFamily="Segoe MDL2 Assets" FontSize="15"/>
                  <TextBlock Grid.Column="1" Text="Geri Yükleme" FontSize="12" VerticalAlignment="Center"/>
                </Grid>
              </Button>
              <Button Style="{StaticResource NavButton}" Command="{Binding OpenHistoryCommand}">
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                  <Border Width="3" Height="22" CornerRadius="2" Background="{DynamicResource Accent}"
                          HorizontalAlignment="Left" Margin="-12,0,0,0">
                    <Border.Style>
                      <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers><DataTrigger Binding="{Binding IsPanelHistory}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                      </Style>
                    </Border.Style>
                  </Border>
                  <TextBlock Text="" FontFamily="Segoe MDL2 Assets" FontSize="15"/>
                  <TextBlock Grid.Column="1" Text="Geçmiş" FontSize="12" VerticalAlignment="Center"/>
                </Grid>
              </Button>
              <Button Style="{StaticResource NavButton}" Command="{Binding OpenSchedulerCommand}">
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                  <Border Width="3" Height="22" CornerRadius="2" Background="{DynamicResource Accent}"
                          HorizontalAlignment="Left" Margin="-12,0,0,0">
                    <Border.Style>
                      <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers><DataTrigger Binding="{Binding IsPanelScheduler}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                      </Style>
                    </Border.Style>
                  </Border>
                  <TextBlock Text="" FontFamily="Segoe MDL2 Assets" FontSize="15"/>
                  <TextBlock Grid.Column="1" Text="Zamanlayıcı" FontSize="12" VerticalAlignment="Center"/>
                </Grid>
              </Button>
              <Button Style="{StaticResource NavButton}" Command="{Binding OpenSettingsCommand}">
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                  <Border Width="3" Height="22" CornerRadius="2" Background="{DynamicResource Accent}"
                          HorizontalAlignment="Left" Margin="-12,0,0,0">
                    <Border.Style>
                      <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers><DataTrigger Binding="{Binding IsPanelSettings}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                      </Style>
                    </Border.Style>
                  </Border>
                  <TextBlock Text="" FontFamily="Segoe MDL2 Assets" FontSize="15"/>
                  <TextBlock Grid.Column="1" Text="Ayarlar" FontSize="12" VerticalAlignment="Center"/>
                </Grid>
              </Button>
            </StackPanel>

            <Grid Grid.Row="2"/>

            <Border Grid.Row="3" Margin="12" Padding="10"
                    Background="{DynamicResource AccentSubtle}" CornerRadius="5">
              <StackPanel>
                <TextBlock Text="Hazır" FontSize="11" FontWeight="SemiBold"
                           Foreground="{DynamicResource AccentLight}"/>
                <TextBlock Text="{Binding MachineName}" FontSize="9" FontFamily="Consolas"
                           Foreground="{DynamicResource TextSecondary}" Margin="0,2,0,0"/>
              </StackPanel>
            </Border>
          </Grid>
        </Border>

        <!-- Content -->
        <Grid Grid.Column="1" Background="{DynamicResource BgPrimary}">

          <!-- BACKUP -->
          <Grid Margin="20">
            <Grid.Style>
              <Style TargetType="Grid">
                <Setter Property="Visibility" Value="Collapsed"/>
                <Style.Triggers>
                  <DataTrigger Binding="{Binding IsPanelBackup}" Value="True">
                    <Setter Property="Visibility" Value="Visible"/>
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </Grid.Style>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="12"/>
              <RowDefinition Height="*"/>
              <RowDefinition Height="12"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock Text="Yeni Yedek" FontSize="24" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimary}"/>
                <TextBlock Text="Kaynakları seçin, hedefi belirleyin ve doğrulanmış yedeği başlatın."
                           FontSize="11" Foreground="{DynamicResource TextTertiary}" Margin="0,4,0,0"/>
              </StackPanel>
              <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Style="{StaticResource SecondaryButton}" Command="{Binding ClearAllCommand}" Margin="0,0,6,0">
                  <TextBlock Text="Seçimi Temizle"/>
                </Button>
                <Button Style="{StaticResource SecondaryButton}" Command="{Binding SelectAllCommand}">
                  <TextBlock Text="Tümünü Seç"/>
                </Button>
              </StackPanel>
            </Grid>

            <Grid Grid.Row="2">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.45*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="1*"/>
              </Grid.ColumnDefinitions>

              <!-- Source workspace -->
              <Border Grid.Column="0" Style="{StaticResource ShellCard}" Padding="0">
                <Grid>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="50"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                  </Grid.RowDefinitions>
                  <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="16,0">
                    <Grid>
                      <TextBlock Text="Yedek Kaynakları" Style="{StaticResource SectionTitle}" VerticalAlignment="Center"/>
                      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Style="{StaticResource MiniButton}" Command="{Binding AddCustomFolderCommand}"
                                ToolTip="Yedeklenecek özel bir klasör ekle" Margin="0,0,8,0">
                          <StackPanel Orientation="Horizontal">
                            <TextBlock Text="+" Margin="0,0,4,0"/>
                            <TextBlock Text="Özel Klasör"/>
                          </StackPanel>
                        </Button>
                        <TextBlock Text="{Binding SelectedSummary}" VerticalAlignment="Center"
                                   FontSize="10" FontFamily="Consolas" Foreground="{DynamicResource AccentLight}"/>
                      </StackPanel>
                    </Grid>
                  </Border>
                  <Border Grid.Row="1" Margin="12,9,12,8" Padding="10,8"
                          Background="{DynamicResource BgTertiary}" BorderBrush="{DynamicResource BorderBrush}"
                          BorderThickness="1" CornerRadius="5">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="7"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="5"/>
                        <ColumnDefinition Width="34"/>
                        <ColumnDefinition Width="34"/>
                        <ColumnDefinition Width="34"/>
                        <ColumnDefinition Width="34"/>
                        <ColumnDefinition Width="34"/>
                      </Grid.ColumnDefinitions>
                      <StackPanel>
                        <TextBlock Text="YEDEK PROFİLİ" Style="{StaticResource FieldLabel}"/>
                        <ComboBox Style="{StaticResource ItchyComboBox}" ItemsSource="{Binding SavedProfiles}"
                                  SelectedItem="{Binding SelectedQuickProfile}" Height="36">
                          <ComboBox.ItemTemplate>
                            <DataTemplate>
                              <TextBlock Text="{Binding ProfileName}"/>
                            </DataTemplate>
                          </ComboBox.ItemTemplate>
                        </ComboBox>
                      </StackPanel>
                      <Button Grid.Column="2" Style="{StaticResource PrimaryButton}" Padding="14,10"
                              Command="{Binding ApplySelectedProfileCommand}" VerticalAlignment="Bottom">
                        <StackPanel Orientation="Horizontal">
                          <TextBlock Text="" FontFamily="Segoe MDL2 Assets" Margin="0,0,6,0"/>
                          <TextBlock Text="Uygula"/>
                        </StackPanel>
                      </Button>
                      <Button Grid.Column="4" Style="{StaticResource MiniButton}" Padding="0" Height="36"
                              Command="{Binding CreateProfileCommand}" ToolTip="Yeni profil oluştur"
                              VerticalAlignment="Bottom">
                        <TextBlock Text="+" FontSize="16" FontWeight="SemiBold"
                                   Foreground="{DynamicResource AccentLight}"/>
                      </Button>
                      <Button Grid.Column="5" Style="{StaticResource MiniButton}" Padding="0" Height="36"
                              Command="{Binding EditSelectedProfileCommand}" ToolTip="Seçili profili düzenle / yeniden adlandır"
                              VerticalAlignment="Bottom">
                        <TextBlock Text="" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource AccentLight}"/>
                      </Button>
                      <Button Grid.Column="6" Style="{StaticResource MiniButton}" Padding="0" Height="36"
                              Command="{Binding ExportSelectedProfileCommand}" ToolTip="Seçili profili dışa aktar"
                              VerticalAlignment="Bottom">
                        <TextBlock Text="" FontFamily="Segoe MDL2 Assets"/>
                      </Button>
                      <Button Grid.Column="7" Style="{StaticResource MiniButton}" Padding="0" Height="36"
                              Command="{Binding ImportProfileCommand}" ToolTip="Profil içe aktar"
                              VerticalAlignment="Bottom">
                        <TextBlock Text="" FontFamily="Segoe MDL2 Assets"/>
                      </Button>
                      <Button Grid.Column="8" Style="{StaticResource MiniButton}" Padding="0" Height="36"
                              Command="{Binding DeleteSelectedProfileCommand}" ToolTip="Seçili profili sil"
                              VerticalAlignment="Bottom">
                        <TextBlock Text="" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource Danger}"/>
                      </Button>
                    </Grid>
                  </Border>
                  <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="10,4,8,10">
                    <ItemsControl ItemsSource="{Binding Categories}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type models:BackupCategory}">
                          <Border Margin="0,0,0,6" Background="{DynamicResource BgTertiary}"
                                  BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4">
                            <StackPanel>
                              <Grid Height="44" Margin="10,0" Cursor="Hand"
                                    MouseLeftButtonUp="CategoryHeader_MouseLeftButtonUp">
                                <Grid.ColumnDefinitions>
                                  <ColumnDefinition Width="22"/>
                                  <ColumnDefinition Width="28"/>
                                  <ColumnDefinition Width="*"/>
                                  <ColumnDefinition Width="Auto"/>
                                  <ColumnDefinition Width="24"/>
                                </Grid.ColumnDefinitions>
                                <CheckBox Grid.Column="0" Style="{StaticResource ItchyCheckBox}"
                                          IsChecked="{Binding MasterChecked}" Tag="{Binding}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"
                                          PreviewMouseLeftButtonDown="CategoryCheckBox_MouseDown"/>
                                <Viewbox Grid.Column="1" Width="17" Height="17" VerticalAlignment="Center">
                                  <Path Data="{Binding CategoryIconPath}" Fill="{DynamicResource Accent}"/>
                                </Viewbox>
                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                  <TextBlock Text="{Binding Name}" FontSize="11" FontWeight="SemiBold"
                                             Foreground="{DynamicResource TextPrimary}"/>
                                  <TextBlock Text="{Binding Description}" FontSize="9"
                                             Foreground="{DynamicResource TextTertiary}"/>
                                </StackPanel>
                                <TextBlock Grid.Column="3" Text="{Binding SelectedCount, StringFormat={}{0} seçili}"
                                           FontSize="9" FontFamily="Consolas"
                                           Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"/>
                                <Button Grid.Column="4" Background="Transparent" BorderThickness="0" Cursor="Hand"
                                        Command="{Binding ToggleExpandCommand}" ToolTip="Kategoriyi aç/kapat">
                                  <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="9"
                                             Foreground="{DynamicResource TextTertiary}">
                                    <TextBlock.RenderTransform>
                                      <RotateTransform Angle="0" CenterX="4" CenterY="4"/>
                                    </TextBlock.RenderTransform>
                                    <TextBlock.Style>
                                      <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value=""/>
                                        <Style.Triggers>
                                          <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                            <Setter Property="Text" Value=""/>
                                          </DataTrigger>
                                        </Style.Triggers>
                                      </Style>
                                    </TextBlock.Style>
                                  </TextBlock>
                                </Button>
                              </Grid>
                              <ItemsControl ItemsSource="{Binding Items}">
                                <ItemsControl.Style>
                                  <Style TargetType="ItemsControl">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                      <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                      </DataTrigger>
                                    </Style.Triggers>
                                  </Style>
                                </ItemsControl.Style>
                                <ItemsControl.ItemTemplate>
                                  <DataTemplate DataType="{x:Type models:BackupItem}">
                                    <Grid Margin="28,0,10,7">
                                      <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="22"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                      </Grid.ColumnDefinitions>
                                      <CheckBox Style="{StaticResource ItchyCheckBox}" IsChecked="{Binding IsSelected}"
                                                HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                      <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding Label}" FontSize="10"
                                                   Foreground="{DynamicResource TextSecondary}"/>
                                        <TextBlock Text="{Binding Path}" FontSize="8" FontFamily="Consolas"
                                                   Foreground="{DynamicResource TextMuted}" TextTrimming="CharacterEllipsis"/>
                                      </StackPanel>
                                      <TextBlock Grid.Column="2" Text="{Binding EstimatedSize}" FontSize="9"
                                                 FontFamily="Consolas" Foreground="{DynamicResource TextTertiary}"/>
                                      <Button Grid.Column="2" Background="{DynamicResource BgTertiary}" BorderThickness="0"
                                              HorizontalAlignment="Right" Cursor="Hand"
                                              Command="{Binding DataContext.RemoveCustomFolderCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                              CommandParameter="{Binding}" ToolTip="Özel klasörü kaldır">
                                        <Button.Style>
                                          <Style TargetType="Button">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                              <DataTrigger Binding="{Binding Parent.Type}" Value="CustomFolders">
                                                <Setter Property="Visibility" Value="Visible"/>
                                              </DataTrigger>
                                            </Style.Triggers>
                                          </Style>
                                        </Button.Style>
                                        <TextBlock Text="" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource Danger}"/>
                                      </Button>
                                    </Grid>
                                  </DataTemplate>
                                </ItemsControl.ItemTemplate>
                              </ItemsControl>
                            </StackPanel>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </ScrollViewer>
                </Grid>
              </Border>

              <!-- Options workspace -->
              <Border Grid.Column="2" Style="{StaticResource ShellCard}" Padding="0">
                <Grid>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="50"/>
                    <RowDefinition Height="*"/>
                  </Grid.RowDefinitions>
                  <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="16,0">
                    <TextBlock Text="Yedek Ayarları" Style="{StaticResource SectionTitle}" VerticalAlignment="Center"/>
                  </Border>
                  <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="16">
                      <TextBlock Text="HEDEF KLASÖR" Style="{StaticResource FieldLabel}"/>
                      <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="6"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBox Style="{StaticResource ItchyTextBox}" Text="{Binding DestinationPath, UpdateSourceTrigger=PropertyChanged}"
                                 Height="34" VerticalContentAlignment="Center"/>
                        <Button Grid.Column="2" Style="{StaticResource SecondaryButton}" Command="{Binding BrowseDestinationCommand}"
                                Padding="10,6" ToolTip="Klasör seç">
                          <TextBlock Text="" FontFamily="Segoe MDL2 Assets"/>
                        </Button>
                      </Grid>

                      <DockPanel Margin="0,0,0,10">
                        <Button DockPanel.Dock="Right" Style="{StaticResource MiniButton}" Command="{Binding AddDestinationCommand}">
                          <TextBlock Text="+ Ek Hedef"/>
                        </Button>
                        <TextBlock Text="ÇOKLU HEDEF" Style="{StaticResource FieldLabel}" VerticalAlignment="Center"/>
                      </DockPanel>
                      <ItemsControl ItemsSource="{Binding AdditionalDestinations}" Margin="0,0,0,10">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate>
                            <Border Background="{DynamicResource BgTertiary}" CornerRadius="4" Padding="8,5" Margin="0,0,0,4">
                              <DockPanel>
                                <Button DockPanel.Dock="Right" Background="Transparent" BorderThickness="0"
                                        Command="{Binding DataContext.RemoveDestinationCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}">
                                  <TextBlock Text="×" Foreground="{DynamicResource Danger}"/>
                                </Button>
                                <TextBlock Text="{Binding}" FontSize="9" FontFamily="Consolas"
                                           Foreground="{DynamicResource TextSecondary}" TextTrimming="CharacterEllipsis"/>
                              </DockPanel>
                            </Border>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>

                      <Separator Margin="0,2,0,12"/>
                      <CheckBox Style="{StaticResource ItchyCheckBox}" IsChecked="{Binding UseZip}" Margin="0,0,0,9">
                        <TextBlock Text="ZIP paketi oluştur" FontSize="11"/>
                      </CheckBox>
                      <CheckBox Style="{StaticResource ItchyCheckBox}" IsChecked="{Binding UsePassword}" Margin="0,0,0,9">
                        <TextBlock Text="AES-256 parola koruması" FontSize="11"/>
                      </CheckBox>
                      <Grid Margin="24,0,0,10">
                        <Grid.Style>
                          <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers><DataTrigger Binding="{Binding UsePassword}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                          </Style>
                        </Grid.Style>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="6"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <PasswordBox x:Name="ZipPasswordBox" PasswordChanged="ZipPasswordBox_PasswordChanged"
                                     Background="{DynamicResource BgQuaternary}" Foreground="{DynamicResource TextPrimary}"
                                     BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Height="32" Padding="8,3"/>
                        <TextBox x:Name="ZipPasswordRevealBox" Style="{StaticResource ItchyTextBox}"
                                 Text="{Binding ZipPassword, UpdateSourceTrigger=PropertyChanged}"
                                 Height="32" Visibility="Collapsed"/>
                        <Button Grid.Column="2" Style="{StaticResource MiniButton}" Click="ZipPasswordReveal_Click" ToolTip="Parolayı göster/gizle">
                          <TextBlock Text="" FontFamily="Segoe MDL2 Assets"/>
                        </Button>
                      </Grid>
                      <CheckBox Style="{StaticResource ItchyCheckBox}" IsChecked="{Binding VerifyChecksum}" Margin="0,0,0,9">
                        <TextBlock Text="SHA-256 ile otomatik doğrula" FontSize="11"/>
                      </CheckBox>
                      <CheckBox Style="{StaticResource ItchyCheckBox}" IsChecked="{Binding UseVss}" Margin="0,0,0,9">
                        <TextBlock Text="Açık dosyalar için VSS kullan" FontSize="11"/>
                      </CheckBox>
                      <CheckBox Style="{StaticResource ItchyCheckBox}" IsChecked="{Binding IsIncremental}" Margin="0,0,0,12">
                        <TextBlock Text="Artımlı yedekleme" FontSize="11"/>
                      </CheckBox>

                      <TextBlock Text="ROTASYON" Style="{StaticResource FieldLabel}"/>
                      <ComboBox Style="{StaticResource ItchyComboBox}" SelectedIndex="{Binding RotationPolicyIndex}" Height="32" Margin="0,0,0,12">
                        <ComboBoxItem Content="Rotasyon yok"/>
                        <ComboBoxItem Content="Son N yedeği sakla"/>
                        <ComboBoxItem Content="Belirli günden eskiyi sil"/>
                      </ComboBox>
                      <Grid Margin="0,-4,0,12">
                        <Grid.Style>
                          <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding RotationIsKeepLastN}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </Grid.Style>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*"/>
                          <ColumnDefinition Width="88"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                          <TextBlock Text="SAKLANACAK YEDEK SAYISI" Style="{StaticResource FieldLabel}"/>
                          <TextBlock Text="En yeni yedekler korunur, daha eskiler silinir."
                                     FontSize="9" Foreground="{DynamicResource TextTertiary}"/>
                        </StackPanel>
                        <TextBox Grid.Column="1" Style="{StaticResource ItchyTextBox}"
                                 Text="{Binding RotationKeepLastN, UpdateSourceTrigger=PropertyChanged}"
                                 Height="36" FontSize="15" TextAlignment="Center" VerticalContentAlignment="Center"/>
                      </Grid>
                      <Grid Margin="0,-4,0,12">
                        <Grid.Style>
                          <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding RotationIsDeleteOlderThan}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </Grid.Style>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*"/>
                          <ColumnDefinition Width="88"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                          <TextBlock Text="GÜN SINIRI" Style="{StaticResource FieldLabel}"/>
                          <TextBlock Text="Bu süreden eski yedekler otomatik silinir."
                                     FontSize="9" Foreground="{DynamicResource TextTertiary}"/>
                        </StackPanel>
                        <TextBox Grid.Column="1" Style="{StaticResource ItchyTextBox}"
                                 Text="{Binding RotationDeleteOlderThanDays, UpdateSourceTrigger=PropertyChanged}"
                                 Height="36" FontSize="15" TextAlignment="Center" VerticalContentAlignment="Center"/>
                      </Grid>

                      <CheckBox Style="{StaticResource ItchyCheckBox}" IsChecked="{Binding UseNetworkCredentials}" Margin="0,0,0,9">
                        <TextBlock Text="Ağ kimlik bilgisi kullan" FontSize="11"/>
                      </CheckBox>
                      <StackPanel Margin="24,0,0,0">
                        <StackPanel.Style>
                          <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers><DataTrigger Binding="{Binding UseNetworkCredentials}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                          </Style>
                        </StackPanel.Style>
                        <Grid Margin="0,0,0,6">
                          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="6"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                          <StackPanel>
                            <TextBlock Text="AĞ KULLANICI ADI" Style="{StaticResource FieldLabel}"/>
                            <TextBox Style="{StaticResource ItchyTextBox}" Text="{Binding NetworkUsername}" Height="32"/>
                          </StackPanel>
                          <StackPanel Grid.Column="2">
                            <TextBlock Text="ETKİ ALANI / DOMAIN" Style="{StaticResource FieldLabel}"/>
                            <TextBox Style="{StaticResource ItchyTextBox}" Text="{Binding NetworkDomain}" Height="32"/>
                          </StackPanel>
                        </Grid>
                        <TextBlock Text="AĞ HESABI PAROLASI" Style="{StaticResource FieldLabel}"/>
                        <Grid>
                          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="6"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                          <PasswordBox x:Name="NetworkPasswordBox" PasswordChanged="NetworkPasswordBox_PasswordChanged"
                                       Background="{DynamicResource BgQuaternary}" Foreground="{DynamicResource TextPrimary}"
                                       BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Height="32" Padding="8,3"/>
                          <TextBox x:Name="NetworkPasswordRevealBox" Style="{StaticResource ItchyTextBox}"
                                   Text="{Binding NetworkPassword, UpdateSourceTrigger=PropertyChanged}"
                                   Height="32" Visibility="Collapsed"/>
                          <Button Grid.Column="2" Style="{StaticResource MiniButton}" Click="NetworkPasswordReveal_Click">
                            <TextBlock Text="" FontFamily="Segoe MDL2 Assets"/>
                          </Button>
                        </Grid>
                      </StackPanel>
                    </StackPanel>
                  </ScrollViewer>
                </Grid>
              </Border>
            </Grid>

            <!-- Action dock -->
            <Border Grid.Row="4" Style="{StaticResource ShellCard}" Padding="14,10">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                  <TextBlock Text="{Binding SelectedSummary}" FontSize="12" FontWeight="SemiBold"
                             Foreground="{DynamicResource TextPrimary}"/>
                  <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                    <TextBlock Text="{Binding SelectedSizeText}" FontSize="9" FontFamily="Consolas"
                               Foreground="{DynamicResource TextTertiary}"/>
                    <TextBlock Text="  •  " Foreground="{DynamicResource TextMuted}"/>
                    <TextBlock Text="{Binding PreflightSummary}" FontSize="9" FontFamily="Consolas"
                               Foreground="{DynamicResource AccentLight}"/>
                  </StackPanel>
                  <StackPanel Visibility="{Binding IsBackingUp, Converter={StaticResource BoolToVis}}" Margin="0,8,20,0">
                    <ProgressBar Style="{StaticResource ItchyProgressBar}" Value="{Binding ProgressPercent}" Maximum="100"/>
                    <TextBlock Text="{Binding CurrentFile}" FontSize="9" FontFamily="Consolas"
                               Foreground="{DynamicResource TextTertiary}" TextTrimming="CharacterEllipsis" Margin="0,4,0,0"/>
                  </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                  <Button Style="{StaticResource SecondaryButton}" Command="{Binding RunPreflightCommand}" Margin="0,0,8,0">
                    <TextBlock Text="Kontrol Et"/>
                  </Button>
                  <Button Style="{StaticResource SecondaryButton}" Command="{Binding SaveProfileCommand}" Margin="0,0,8,0">
                    <TextBlock Text="Profil Kaydet"/>
                  </Button>
                  <Button Style="{StaticResource DangerButton}" Command="{Binding CancelBackupCommand}" Margin="0,0,8,0"
                          Visibility="{Binding IsBackingUp, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="İptal"/>
                  </Button>
                  <Button Style="{StaticResource PrimaryButton}" Command="{Binding StartBackupCommand}" MinWidth="150">
                    <TextBlock Text="Yedeği Başlat"/>
                  </Button>
                </StackPanel>
              </Grid>
            </Border>
          </Grid>

          <!-- RESTORE -->
          <Grid Margin="20">
            <Grid.Style>
              <Style TargetType="Grid">
                <Setter Property="Visibility" Value="Collapsed"/>
                <Style.Triggers><DataTrigger Binding="{Binding IsPanelRestore}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
              </Style>
            </Grid.Style>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="12"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <StackPanel>
              <TextBlock Text="Geri Yükleme Merkezi" FontSize="24" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
              <TextBlock Text="Dosya yedeklerini veya Windows sistem durumunu geri yükleyin."
                         FontSize="11" Foreground="{DynamicResource TextTertiary}" Margin="0,4,0,0"/>
            </StackPanel>
            <Grid Grid.Row="2">
              <Grid.ColumnDefinitions><ColumnDefinition Width="1.1*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>

              <Border Grid.Column="0" Style="{StaticResource ShellCard}" Padding="0">
                <Grid>
                  <Grid.RowDefinitions><RowDefinition Height="50"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                  <Border Padding="16,0" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                    <TextBlock Text="Dosya Yedeği" Style="{StaticResource SectionTitle}" VerticalAlignment="Center"/>
                  </Border>
                  <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="16">
                      <TextBlock Text="YEDEK" Style="{StaticResource FieldLabel}"/>
                      <ComboBox Style="{StaticResource ItchyComboBox}" ItemsSource="{Binding AvailableBackups}"
                                SelectedItem="{Binding SelectedBackupForRestore}" DisplayMemberPath="Name"
                                Height="34" Margin="0,0,0,12"/>
                      <TextBlock Text="HEDEF KLASÖR" Style="{StaticResource FieldLabel}"/>
                      <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="6"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBox Style="{StaticResource ItchyTextBox}" Text="{Binding RestoreTargetPath}" Height="34"/>
                        <Button Grid.Column="2" Style="{StaticResource SecondaryButton}" Command="{Binding BrowseRestoreTargetCommand}" Padding="10,6">
                          <TextBlock Text="" FontFamily="Segoe MDL2 Assets"/>
                        </Button>
                      </Grid>
                      <TextBlock Text="ÇAKIŞMA DAVRANIŞI" Style="{StaticResource FieldLabel}"/>
                      <ComboBox Style="{StaticResource ItchyComboBox}" SelectedIndex="{Binding RestoreConflictPolicyIndex}" Height="34" Margin="0,0,0,10">
                        <ComboBoxItem Content="Var olan dosyayı atla"/>
                        <ComboBoxItem Content="Var olan dosyanın üzerine yaz"/>
                        <ComboBoxItem Content="Yeni isimle geri yükle"/>
                      </ComboBox>
                      <CheckBox Style="{StaticResource ItchyCheckBox}" IsChecked="{Binding RestorePartial}" Margin="0,0,0,10">
                        <TextBlock Text="Yalnızca seçili klasörleri geri yükle" FontSize="11"/>
                      </CheckBox>

                      <StackPanel>
                        <StackPanel.Style>
                          <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers><DataTrigger Binding="{Binding SelectedBackupForRestore.IsZip}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                          </Style>
                        </StackPanel.Style>
                        <TextBlock Text="ZIP PAROLASI" Style="{StaticResource FieldLabel}"/>
                        <Grid Margin="0,0,0,10">
                          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="6"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                          <PasswordBox x:Name="RestoreZipPasswordBox" PasswordChanged="RestoreZipPasswordBox_PasswordChanged"
                                       Background="{DynamicResource BgQuaternary}" Foreground="{DynamicResource TextPrimary}"
                                       BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Height="32" Padding="8,3"/>
                          <TextBox x:Name="RestoreZipPasswordRevealBox" Style="{StaticResource ItchyTextBox}"
                                   Text="{Binding RestoreZipPassword}" Height="32" Visibility="Collapsed"/>
                          <Button Grid.Column="2" Style="{StaticResource MiniButton}" Click="RestoreZipPasswordReveal_Click">
                            <TextBlock Text="" FontFamily="Segoe MDL2 Assets"/>
                          </Button>
                        </Grid>
                      </StackPanel>

                      <Border Background="{DynamicResource BgTertiary}" CornerRadius="4" Padding="10" Margin="0,0,0,10">
                        <DockPanel>
                          <Button DockPanel.Dock="Right" Style="{StaticResource MiniButton}"
                                  Command="{Binding RefreshRestorePreviewCommand}" ToolTip="Önizlemeyi yenile">
                            <TextBlock Text="" FontFamily="Segoe MDL2 Assets"/>
                          </Button>
                          <TextBlock Text="{Binding RestorePreviewText}" FontSize="9" FontFamily="Consolas"
                                     Foreground="{DynamicResource AccentLight}" TextWrapping="Wrap"/>
                        </DockPanel>
                      </Border>

                      <DockPanel Margin="0,0,0,8">
                        <Button DockPanel.Dock="Right" Style="{StaticResource MiniButton}"
                                Command="{Binding ClearAllRestoreItemsCommand}" Margin="6,0,0,0">
                          <TextBlock Text="Temizle"/>
                        </Button>
                        <Button DockPanel.Dock="Right" Style="{StaticResource MiniButton}"
                                Command="{Binding SelectAllRestoreItemsCommand}">
                          <TextBlock Text="Tümünü Seç"/>
                        </Button>
                        <TextBlock Text="GERİ YÜKLENECEK KLASÖRLER" Style="{StaticResource FieldLabel}"
                                   VerticalAlignment="Center"/>
                      </DockPanel>
                      <ItemsControl ItemsSource="{Binding RestoreFolders}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate>
                            <Grid Margin="0,0,0,6">
                              <Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                              <CheckBox Style="{StaticResource ItchyCheckBox}" IsChecked="{Binding IsSelected}"/>
                              <StackPanel Grid.Column="1">
                                <TextBlock Text="{Binding DisplayName}" FontSize="10" Foreground="{DynamicResource TextPrimary}"/>
                                <TextBlock Text="{Binding SubText}" FontSize="8" FontFamily="Consolas" Foreground="{DynamicResource TextTertiary}"/>
                              </StackPanel>
                              <TextBlock Grid.Column="2" Text="{Binding SizeText}" FontSize="9" FontFamily="Consolas"
                                         Foreground="{DynamicResource TextSecondary}"/>
                            </Grid>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>
                  </ScrollViewer>
                  <Border Grid.Row="2" Padding="14,10" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
                    <StackPanel>
                      <ProgressBar Style="{StaticResource ItchyProgressBar}" Value="{Binding RestoreProgressPercent}" Maximum="100"
                                   Visibility="{Binding IsRestoring, Converter={StaticResource BoolToVis}}" Margin="0,0,0,8"/>
                      <Button Style="{StaticResource DangerButton}" Command="{Binding CancelRestoreCommand}"
                              Visibility="{Binding IsRestoring, Converter={StaticResource BoolToVis}}" Margin="0,0,0,8">
                        <TextBlock Text="Geri Yüklemeyi İptal Et"/>
                      </Button>
                      <Button Style="{StaticResource PrimaryButton}" Command="{Binding StartRestoreCommand}">
                        <TextBlock Text="Geri Yüklemeyi Başlat"/>
                      </Button>
                    </StackPanel>
                  </Border>
                </Grid>
              </Border>

              <Border Grid.Column="2" Style="{StaticResource ShellCard}" Padding="0">
                <Grid>
                  <Grid.RowDefinitions><RowDefinition Height="50"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                  <Border Padding="16,0" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                    <TextBlock Text="Windows Sistem Geri Yükleme" Style="{StaticResource SectionTitle}" VerticalAlignment="Center"/>
                  </Border>
                  <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="16">
                      <TextBlock Text="Sistem dosyaları, kayıt defteri ve sürücü değişiklikleri için Windows geri yükleme noktası oluşturun."
                                 TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,14"/>
                      <TextBlock Text="AÇIKLAMA" Style="{StaticResource FieldLabel}"/>
                      <TextBox Style="{StaticResource ItchyTextBox}" Text="{Binding SystemRestoreDescription}" Height="34" Margin="0,0,0,10"/>
                      <Button Style="{StaticResource PrimaryButton}" Command="{Binding CreateSystemRestorePointCommand}" Margin="0,0,0,8">
                        <TextBlock Text="Geri Yükleme Noktası Oluştur"/>
                      </Button>
                      <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="6"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Button Style="{StaticResource SecondaryButton}" Command="{Binding OpenWindowsSystemRestoreCommand}">
                          <TextBlock Text="Windows Restore"/>
                        </Button>
                        <Button Grid.Column="2" Style="{StaticResource SecondaryButton}" Command="{Binding OpenSystemProtectionCommand}">
                          <TextBlock Text="Sistem Koruması"/>
                        </Button>
                      </Grid>
                      <DockPanel Margin="0,0,0,8">
                        <Button DockPanel.Dock="Right" Style="{StaticResource MiniButton}" Command="{Binding LoadSystemRestorePointsCommand}">
                          <TextBlock Text="Yenile"/>
                        </Button>
                        <TextBlock Text="SON NOKTALAR" Style="{StaticResource FieldLabel}" VerticalAlignment="Center"/>
                      </DockPanel>
                      <TextBlock Text="{Binding SystemRestoreStatus}" FontSize="9" FontFamily="Consolas"
                                 Foreground="{DynamicResource AccentLight}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                      <ItemsControl ItemsSource="{Binding SystemRestorePoints}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate>
                            <Border Background="{DynamicResource BgTertiary}" CornerRadius="4" Padding="9,7" Margin="0,0,0,5">
                              <DockPanel>
                                <TextBlock DockPanel.Dock="Right" Text="{Binding SequenceNumber}" FontSize="9"
                                           FontFamily="Consolas" Foreground="{DynamicResource TextTertiary}"/>
                                <StackPanel>
                                  <TextBlock Text="{Binding Description}" FontSize="10" FontWeight="SemiBold"
                                             Foreground="{DynamicResource TextPrimary}"/>
                                  <TextBlock Text="{Binding CreationTime}" FontSize="8" FontFamily="Consolas"
                                             Foreground="{DynamicResource TextTertiary}"/>
                                </StackPanel>
                              </DockPanel>
                            </Border>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>
                  </ScrollViewer>
                </Grid>
              </Border>
            </Grid>
          </Grid>

          <!-- HISTORY -->
          <Grid Margin="20">
            <Grid.Style>
              <Style TargetType="Grid">
                <Setter Property="Visibility" Value="Collapsed"/>
                <Style.Triggers><DataTrigger Binding="{Binding IsPanelHistory}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
              </Style>
            </Grid.Style>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="12"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Grid>
              <StackPanel>
                <TextBlock Text="Yedek Geçmişi" FontSize="24" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                <TextBlock Text="Önceki yedekleri doğrulayın, karşılaştırın ve raporlarına erişin."
                           FontSize="11" Foreground="{DynamicResource TextTertiary}" Margin="0,4,0,0"/>
              </StackPanel>
              <Button HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource SecondaryButton}"
                      Command="{Binding OpenLogFolderCommand}">
                <TextBlock Text="Log Klasörü"/>
              </Button>
            </Grid>
            <Grid Grid.Row="2">
              <Grid.ColumnDefinitions><ColumnDefinition Width="1.5*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>
              <Border Grid.Column="0" Style="{StaticResource ShellCard}" Padding="0">
                <Grid>
                  <Grid.RowDefinitions><RowDefinition Height="50"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                  <Border Padding="16,0" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                    <TextBlock Text="Kayıtlar" Style="{StaticResource SectionTitle}" VerticalAlignment="Center"/>
                  </Border>
                  <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding BackupHistory}" Margin="10">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type models:HistoryEntry}">
                          <Border Background="{DynamicResource BgTertiary}" CornerRadius="4" Padding="12,9" Margin="0,0,0,6">
                            <Grid>
                              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                              <StackPanel>
                                <TextBlock Text="{Binding FolderName}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                                <TextBlock Text="{Binding Summary}" FontSize="9" Foreground="{DynamicResource TextTertiary}" Margin="0,3,0,0"/>
                                <TextBlock Text="{Binding Date}" FontSize="8" FontFamily="Consolas" Foreground="{DynamicResource TextMuted}"/>
                              </StackPanel>
                              <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Style="{StaticResource MiniButton}"
                                        Command="{Binding DataContext.VerifyHistoryBackupCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}" Margin="0,0,5,0">
                                  <TextBlock Text="Doğrula"/>
                                </Button>
                                <Button Style="{StaticResource MiniButton}"
                                        Command="{Binding DataContext.OpenHistoryFolderCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding DestinationPath}">
                                  <TextBlock Text="Aç"/>
                                </Button>
                              </StackPanel>
                            </Grid>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </ScrollViewer>
                </Grid>
              </Border>
              <Border Grid.Column="2" Style="{StaticResource ShellCard}">
                <StackPanel>
                  <TextBlock Text="Yedek Karşılaştırma" Style="{StaticResource SectionTitle}" Margin="0,0,0,14"/>
                  <TextBlock Text="İLK YEDEK" Style="{StaticResource FieldLabel}"/>
                  <ComboBox Style="{StaticResource ItchyComboBox}" ItemsSource="{Binding AvailableBackups}"
                            SelectedItem="{Binding CompareBackupA}" DisplayMemberPath="Name" Height="34" Margin="0,0,0,10"/>
                  <TextBlock Text="İKİNCİ YEDEK" Style="{StaticResource FieldLabel}"/>
                  <ComboBox Style="{StaticResource ItchyComboBox}" ItemsSource="{Binding AvailableBackups}"
                            SelectedItem="{Binding CompareBackupB}" DisplayMemberPath="Name" Height="34" Margin="0,0,0,12"/>
                  <Button Style="{StaticResource PrimaryButton}" Command="{Binding CompareSelectedBackupsCommand}">
                    <TextBlock Text="Karşılaştır"/>
                  </Button>
                  <Border Background="{DynamicResource BgTertiary}" CornerRadius="4" Padding="10" Margin="0,12,0,0">
                    <TextBlock Text="{Binding CompareSummary}" TextWrapping="Wrap" FontSize="9" FontFamily="Consolas"
                               Foreground="{DynamicResource TextSecondary}"/>
                  </Border>
                </StackPanel>
              </Border>
            </Grid>
          </Grid>

          <!-- SCHEDULER -->
          <Grid Margin="20">
            <Grid.Style>
              <Style TargetType="Grid">
                <Setter Property="Visibility" Value="Collapsed"/>
                <Style.Triggers><DataTrigger Binding="{Binding IsPanelScheduler}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
              </Style>
            </Grid.Style>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="12"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <StackPanel>
              <TextBlock Text="Zamanlayıcı" FontSize="24" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
              <TextBlock Text="Seçili profili Windows Görev Zamanlayıcısı ile otomatik çalıştırın."
                         FontSize="11" Foreground="{DynamicResource TextTertiary}" Margin="0,4,0,0"/>
            </StackPanel>
            <Grid Grid.Row="2">
              <Grid.ColumnDefinitions><ColumnDefinition Width="1.2*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>
              <Border Grid.Column="0" Style="{StaticResource ShellCard}">
                <StackPanel>
                  <DockPanel Margin="0,0,0,16">
                    <CheckBox DockPanel.Dock="Right" Style="{StaticResource ItchyCheckBox}" IsChecked="{Binding SchedulerEnabled}"/>
                    <TextBlock Text="Otomatik yedekleme" Style="{StaticResource SectionTitle}"/>
                  </DockPanel>
                  <TextBlock Text="PROFİL" Style="{StaticResource FieldLabel}"/>
                  <ComboBox Style="{StaticResource ItchyComboBox}" ItemsSource="{Binding SavedProfiles}"
                            DisplayMemberPath="ProfileName" SelectedValuePath="ProfileName"
                            SelectedValue="{Binding SchedulerProfile}" Height="34" Margin="0,0,0,14"/>
                  <TextBlock Text="YEDEK HEDEFİ" Style="{StaticResource FieldLabel}"/>
                  <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBox Style="{StaticResource ItchyTextBox}" Text="{Binding SchedulerDestinationPath}"
                             Height="34" ToolTip="Zamanlayıcı çalıştığında yedeklerin yazılacağı klasör"/>
                    <Button Grid.Column="2" Style="{StaticResource SecondaryButton}" Padding="12,8"
                            Command="{Binding BrowseSchedulerDestinationCommand}">
                      <TextBlock Text="Seç"/>
                    </Button>
                  </Grid>
                  <TextBlock Text="SAAT" Style="{StaticResource FieldLabel}"/>
                  <Border Background="{DynamicResource BgTertiary}" BorderBrush="{DynamicResource BorderBrush}"
                          BorderThickness="1" CornerRadius="6" Padding="14,12" Margin="0,0,0,14">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="34"/>
                        <ColumnDefinition Width="*"/>
                      </Grid.ColumnDefinitions>
                      <StackPanel>
                        <TextBlock Text="SAAT" Style="{StaticResource FieldLabel}" HorizontalAlignment="Center"/>
                        <ComboBox Style="{StaticResource ItchyComboBox}" ItemsSource="{Binding SchedulerHours}"
                                  SelectedItem="{Binding SchedulerHour}" Height="46" FontSize="20"
                                  FontFamily="Consolas" HorizontalContentAlignment="Center"/>
                      </StackPanel>
                      <TextBlock Grid.Column="1" Text=":" FontSize="28" FontFamily="Consolas"
                                 HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,6"
                                 Foreground="{DynamicResource TextSecondary}"/>
                      <StackPanel Grid.Column="2">
                        <TextBlock Text="DAKİKA" Style="{StaticResource FieldLabel}" HorizontalAlignment="Center"/>
                        <ComboBox Style="{StaticResource ItchyComboBox}" ItemsSource="{Binding SchedulerMinutes}"
                                  SelectedItem="{Binding SchedulerMinute}" Height="46" FontSize="20"
                                  FontFamily="Consolas" HorizontalContentAlignment="Center"/>
                      </StackPanel>
                    </Grid>
                  </Border>
                  <TextBlock Text="GÜNLER" Style="{StaticResource FieldLabel}"/>
                  <WrapPanel Margin="0,0,0,16">
                    <CheckBox Style="{StaticResource ItchyCheckBox}" IsChecked="{Binding SchedMon}" Margin="0,0,12,8"><TextBlock Text="Pzt"/></CheckBox>
                    <CheckBox Style="{StaticResource ItchyCheckBox}" IsChecked="{Binding SchedulerTue}" Margin="0,0,12,8"><TextBlock Text="Sal"/></CheckBox>
                    <CheckBox Style="{StaticResource ItchyCheckBox}" IsChecked="{Binding SchedWed}" Margin="0,0,12,8"><TextBlock Text="Çar"/></CheckBox>
                    <CheckBox Style="{StaticResource ItchyCheckBox}" IsChecked="{Binding SchedThu}" Margin="0,0,12,8"><TextBlock Text="Per"/></CheckBox>
                    <CheckBox Style="{StaticResource ItchyCheckBox}" IsChecked="{Binding SchedFri}" Margin="0,0,12,8"><TextBlock Text="Cum"/></CheckBox>
                    <CheckBox Style="{StaticResource ItchyCheckBox}" IsChecked="{Binding SchedSat}" Margin="0,0,12,8"><TextBlock Text="Cmt"/></CheckBox>
                    <CheckBox Style="{StaticResource ItchyCheckBox}" IsChecked="{Binding SchedSun}" Margin="0,0,12,8"><TextBlock Text="Paz"/></CheckBox>
                  </WrapPanel>
                  <Button Style="{StaticResource PrimaryButton}" Command="{Binding SaveSchedulerCommand}">
                    <TextBlock Text="Zamanlayıcıyı Kaydet"/>
                  </Button>
                </StackPanel>
              </Border>
              <Border Grid.Column="2" Style="{StaticResource ShellCard}">
                <StackPanel>
                  <TextBlock Text="Durum" Style="{StaticResource SectionTitle}" Margin="0,0,0,12"/>
                  <Border Background="{DynamicResource AccentSubtle}" CornerRadius="4" Padding="12">
                    <TextBlock Text="{Binding SchedulerStatus}" FontSize="11" FontFamily="Consolas"
                               Foreground="{DynamicResource AccentLight}" TextWrapping="Wrap"/>
                  </Border>
                  <Separator Margin="0,16"/>
                  <TextBlock Text="Görevler en yüksek yetkiyle oluşturulur. VSS, sürücü ve sistem konumları için uygulamanın yönetici yetkisine ihtiyacı olabilir."
                             TextWrapping="Wrap" FontSize="10" Foreground="{DynamicResource TextTertiary}"/>
                </StackPanel>
              </Border>
            </Grid>
          </Grid>

          <!-- SETTINGS -->
          <Grid Margin="20">
            <Grid.Style>
              <Style TargetType="Grid">
                <Setter Property="Visibility" Value="Collapsed"/>
                <Style.Triggers><DataTrigger Binding="{Binding IsPanelSettings}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
              </Style>
            </Grid.Style>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="12"/><RowDefinition Height="*"/><RowDefinition Height="12"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <StackPanel>
              <TextBlock Text="Ayarlar" FontSize="24" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
              <TextBlock Text="Uygulama davranışı, bildirimler ve görünüm."
                         FontSize="11" Foreground="{DynamicResource TextTertiary}" Margin="0,4,0,0"/>
            </StackPanel>
            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="1*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                  <Border Style="{StaticResource ShellCard}" Margin="0,0,0,12">
                    <StackPanel>
                      <TextBlock Text="Genel" Style="{StaticResource SectionTitle}" Margin="0,0,0,14"/>
                      <CheckBox Style="{StaticResource ItchyCheckBox}" IsChecked="{Binding StartWithWindows}" Margin="0,0,0,10">
                        <TextBlock Text="Windows ile başlat"/>
                      </CheckBox>
                      <CheckBox Style="{StaticResource ItchyCheckBox}" IsChecked="{Binding MinimizeToTray}" Margin="0,0,0,10">
                        <TextBlock Text="Kapatınca sistem tepsisine küçült"/>
                      </CheckBox>
                      <CheckBox Style="{StaticResource ItchyCheckBox}" IsChecked="{Binding AutoChecksum}" Margin="0,0,0,10">
                        <TextBlock Text="Otomatik checksum doğrulaması"/>
                      </CheckBox>
                      <CheckBox Style="{StaticResource ItchyCheckBox}" IsChecked="{Binding OpenFolderAfterBackup}">
                        <TextBlock Text="Yedek bitince hedef klasörü aç"/>
                      </CheckBox>
                      <CheckBox Style="{StaticResource ItchyCheckBox}" IsChecked="{Binding SoundNotification}" Margin="0,10,0,12">
                        <TextBlock Text="İşlem tamamlanınca sesli bildirim"/>
                      </CheckBox>
                      <TextBlock Text="VARSAYILAN YEDEK KLASÖRÜ" Style="{StaticResource FieldLabel}"/>
                      <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="6"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBox Style="{StaticResource ItchyTextBox}" Text="{Binding DefaultDestination}" Height="32"/>
                        <Button Grid.Column="2" Style="{StaticResource SecondaryButton}"
                                Command="{Binding BrowseDefaultDestinationCommand}" Padding="10,6" ToolTip="Klasör seç">
                          <TextBlock Text="" FontFamily="Segoe MDL2 Assets"/>
                        </Button>
                      </Grid>
                    </StackPanel>
                  </Border>
                  <Border Style="{StaticResource ShellCard}">
                    <StackPanel>
                      <TextBlock Text="Görünüm" Style="{StaticResource SectionTitle}" Margin="0,0,0,14"/>
                      <TextBlock Text="TEMA" Style="{StaticResource FieldLabel}"/>
                      <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="6"/><ColumnDefinition Width="*"/><ColumnDefinition Width="6"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Button Style="{StaticResource SecondaryButton}" Command="{Binding SetThemeCommand}" CommandParameter="Dark"><TextBlock Text="Koyu"/></Button>
                        <Button Grid.Column="2" Style="{StaticResource SecondaryButton}" Command="{Binding SetThemeCommand}" CommandParameter="Light"><TextBlock Text="Açık"/></Button>
                        <Button Grid.Column="4" Style="{StaticResource SecondaryButton}" Command="{Binding SetThemeCommand}" CommandParameter="Service"><TextBlock Text="Servis"/></Button>
                      </Grid>
                      <TextBlock Text="VURGU RENGİ" Style="{StaticResource FieldLabel}"/>
                      <StackPanel Orientation="Horizontal">
                        <Button Width="30" Height="30" Background="#007A4D" BorderThickness="0" Command="{Binding SetAccentCommand}" CommandParameter="#007A4D" Margin="0,0,6,0"/>
                        <Button Width="30" Height="30" Background="#00B875" BorderThickness="0" Command="{Binding SetAccentCommand}" CommandParameter="#00B875" Margin="0,0,6,0"/>
                        <Button Width="30" Height="30" Background="#00CEC9" BorderThickness="0" Command="{Binding SetAccentCommand}" CommandParameter="#00CEC9" Margin="0,0,6,0"/>
                        <Button Width="30" Height="30" Background="#FDCB6E" BorderThickness="0" Command="{Binding SetAccentCommand}" CommandParameter="#FDCB6E"/>
                      </StackPanel>
                    </StackPanel>
                  </Border>
                </StackPanel>

                <Border Grid.Column="2" Style="{StaticResource ShellCard}">
                  <StackPanel>
                    <TextBlock Text="Bildirimler" Style="{StaticResource SectionTitle}" Margin="0,0,0,14"/>
                    <CheckBox Style="{StaticResource ItchyCheckBox}" IsChecked="{Binding EnableWebhookNotifications}" Margin="0,0,0,8">
                      <TextBlock Text="Webhook bildirimi"/>
                    </CheckBox>
                    <TextBlock Text="WEBHOOK URL" Style="{StaticResource FieldLabel}"/>
                    <TextBox Style="{StaticResource ItchyTextBox}" Text="{Binding WebhookUrl}" Height="32" Margin="0,0,0,12"/>
                    <CheckBox Style="{StaticResource ItchyCheckBox}" IsChecked="{Binding EnableEmailNotifications}" Margin="0,0,0,8">
                      <TextBlock Text="Müşteriye e-posta bildirimi"/>
                    </CheckBox>
                    <Border Background="{DynamicResource AccentSubtle}" CornerRadius="5" Padding="10" Margin="0,0,0,10">
                      <StackPanel>
                        <TextBlock Text="GÖNDEREN" Style="{StaticResource FieldLabel}"/>
                        <TextBlock Text="Itchy Backup &lt;info@itchy.com.tr&gt;" FontSize="11"
                                   Foreground="{DynamicResource AccentLight}" Margin="0,0,0,8"/>
                        <TextBlock Text="MÜŞTERİ E-POSTA ADRESİ" Style="{StaticResource FieldLabel}"/>
                        <TextBox Style="{StaticResource ItchyTextBox}" Text="{Binding EmailTo, UpdateSourceTrigger=PropertyChanged}"
                                 Height="34" Margin="0,0,0,8"/>
                        <Button Style="{StaticResource PrimaryButton}" Command="{Binding TestNotificationsCommand}">
                          <StackPanel Orientation="Horizontal">
                            <TextBlock Text="" FontFamily="Segoe MDL2 Assets" Margin="0,0,7,0"/>
                            <TextBlock Text="Müşteriye Test E-postası Gönder"/>
                          </StackPanel>
                        </Button>
                      </StackPanel>
                    </Border>
                  </StackPanel>
                </Border>
              </Grid>
            </ScrollViewer>
            <DockPanel Grid.Row="4">
              <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Command="{Binding SaveSettingsCommand}" MinWidth="130">
                <TextBlock Text="Ayarları Kaydet"/>
              </Button>
              <Button Width="36" Height="36" Style="{StaticResource SecondaryButton}" Padding="0"
                      Click="GitHubBtn_Click" ToolTip="GitHub sayfasını aç">
                <Viewbox Width="17" Height="17">
                  <Path Fill="{DynamicResource TextSecondary}"
                        Data="M12,0.7C5.7,0.7 0.6,5.8 0.6,12.1C0.6,17.2 3.9,21.5 8.4,23C9,23.1 9.2,22.7 9.2,22.4V20.2C5.8,20.9 5.1,18.8 5.1,18.8C4.5,17.4 3.8,17 3.8,17C2.7,16.3 3.9,16.3 3.9,16.3C5.1,16.4 5.7,17.5 5.7,17.5C6.8,19.3 8.5,18.8 9.2,18.5C9.3,17.7 9.6,17.1 10,16.8C7.3,16.5 4.4,15.4 4.4,10.7C4.4,9.4 4.9,8.3 5.7,7.4C5.6,7.1 5.1,5.8 5.8,4.2C5.8,4.2 6.9,3.9 9.3,5.5C10.3,5.2 11.4,5.1 12.5,5.1C13.6,5.1 14.7,5.2 15.7,5.5C18.1,3.9 19.2,4.2 19.2,4.2C19.9,5.8 19.4,7.1 19.3,7.4C20.1,8.3 20.6,9.4 20.6,10.7C20.6,15.4 17.7,16.5 15,16.8C15.4,17.2 15.8,17.9 15.8,19V22.4C15.8,22.7 16,23.1 16.6,23C21.1,21.5 24.4,17.2 24.4,12.1C24.4,5.8 19.3,0.7 12,0.7Z"/>
                </Viewbox>
              </Button>
            </DockPanel>
          </Grid>

          <!-- RESULT -->
          <Grid Margin="20">
            <Grid.Style>
              <Style TargetType="Grid">
                <Setter Property="Visibility" Value="Collapsed"/>
                <Style.Triggers><DataTrigger Binding="{Binding IsPanelResult}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
              </Style>
            </Grid.Style>
            <Border Style="{StaticResource ShellCard}" MaxWidth="680" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="28">
              <StackPanel>
                <Border Width="52" Height="52" Background="{DynamicResource AccentSubtle}" CornerRadius="26" HorizontalAlignment="Left">
                  <TextBlock Text="✓" FontSize="24" Foreground="{DynamicResource AccentLight}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="Yedekleme tamamlandı" FontSize="24" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimary}" Margin="0,18,0,6"/>
                <TextBlock Text="{Binding LastBackupResult.BackupPath}" FontSize="10" FontFamily="Consolas"
                           Foreground="{DynamicResource TextTertiary}" TextWrapping="Wrap" Margin="0,0,0,18"/>
                <Grid Margin="0,0,0,18">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                  <StackPanel>
                    <TextBlock Text="{Binding LastBackupResult.FilesCopied}" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}"/>
                    <TextBlock Text="Dosya" FontSize="9" Foreground="{DynamicResource TextTertiary}"/>
                  </StackPanel>
                  <StackPanel Grid.Column="1">
                    <TextBlock Text="{Binding LastBackupResult.TotalBytesText}" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}"/>
                    <TextBlock Text="Boyut" FontSize="9" Foreground="{DynamicResource TextTertiary}"/>
                  </StackPanel>
                  <StackPanel Grid.Column="2">
                    <TextBlock Text="{Binding LastBackupResult.Errors.Count}" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}"/>
                    <TextBlock Text="Hata" FontSize="9" Foreground="{DynamicResource TextTertiary}"/>
                  </StackPanel>
                </Grid>
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                  <Button Style="{StaticResource SecondaryButton}" Command="{Binding OpenBackupReportCommand}">
                    <TextBlock Text="Raporu Aç"/>
                  </Button>
                  <Button Grid.Column="2" Style="{StaticResource PrimaryButton}" Command="{Binding CloseResultCommand}">
                    <TextBlock Text="Yeni Yedek"/>
                  </Button>
                </Grid>
              </StackPanel>
            </Border>
          </Grid>
        </Grid>
      </Grid>

      <!-- Status bar -->
      <Border Grid.Row="2" Background="{DynamicResource BgSecondary}"
              BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
        <Grid Margin="12,0">
          <TextBlock Text="Itchy Backup v1.6.0" FontSize="9" FontFamily="Consolas"
                     Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center"/>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
            <Ellipse Width="6" Height="6" Fill="{DynamicResource AccentLight}" Margin="0,0,6,0"/>
            <TextBlock Text="{Binding ProgressText}" FontSize="9" FontFamily="Consolas"
                       Foreground="{DynamicResource TextTertiary}"/>
          </StackPanel>
        </Grid>
      </Border>

      <Border x:Name="ThemeTransitionOverlay" Grid.RowSpan="3"
              Background="{DynamicResource BgPrimary}" Opacity="0"
              IsHitTestVisible="False"/>
    </Grid>
  </Border>
</Window>
