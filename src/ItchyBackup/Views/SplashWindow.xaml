<Window x:Class="ItchyBackup.Views.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Itchy Backup"
        Width="420" Height="260"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False">
  <Border CornerRadius="16" ClipToBounds="True">
    <Border.Background>
      <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#06120E" Offset="0"/>
        <GradientStop Color="#082018" Offset="1"/>
      </LinearGradientBrush>
    </Border.Background>
    <Border.Effect>
      <DropShadowEffect Color="#007A4D" BlurRadius="48" ShadowDepth="0" Opacity="0.6"/>
    </Border.Effect>
    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">

      <!-- Logo -->
      <Border Width="300" Height="90" CornerRadius="12" HorizontalAlignment="Center" Margin="0,0,0,18"
              Background="#06120E">
        <Border.Effect>
          <DropShadowEffect Color="#007A4D" BlurRadius="24" ShadowDepth="0" Opacity="0.65"/>
        </Border.Effect>
        <Border.Triggers>
          <EventTrigger RoutedEvent="Border.Loaded">
            <BeginStoryboard>
              <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                <DoubleAnimation Storyboard.TargetProperty="(UIElement.Effect).(DropShadowEffect.BlurRadius)"
                                 From="14" To="36" Duration="0:0:1.5">
                  <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
                </DoubleAnimation>
              </Storyboard>
            </BeginStoryboard>
          </EventTrigger>
        </Border.Triggers>
        <Image Source="/Resources/Icons/app-logo.png"
               Width="276" Height="82"
               Stretch="Uniform"
               HorizontalAlignment="Center"
               VerticalAlignment="Center"
               RenderOptions.BitmapScalingMode="HighQuality"/>
      </Border>

      <!-- Başlık -->
      <TextBlock Text="Teknik Servis Dosya Yedekleme Aracı" FontSize="10" FontFamily="Consolas"
                 Foreground="#5F7E72" HorizontalAlignment="Center" Margin="0,0,0,28"/>

      <!-- Yükleme çubuğu (track) -->
      <Border Width="220" Height="3" CornerRadius="1.5" Background="#123B2C" HorizontalAlignment="Center">
        <Border x:Name="LoadingBar" Width="0" HorizontalAlignment="Left" CornerRadius="1.5">
          <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
              <GradientStop Color="#00462D" Offset="0"/>
              <GradientStop Color="#00B875" Offset="1"/>
            </LinearGradientBrush>
          </Border.Background>
          <Border.Effect>
            <DropShadowEffect Color="#007A4D" BlurRadius="6" ShadowDepth="0" Opacity="0.7"/>
          </Border.Effect>
        </Border>
      </Border>

      <TextBlock Text="v1.7.0" FontSize="10" FontFamily="Consolas"
                 Foreground="#5A5A72" HorizontalAlignment="Center" Margin="0,14,0,0"/>
    </StackPanel>
  </Border>
</Window>
