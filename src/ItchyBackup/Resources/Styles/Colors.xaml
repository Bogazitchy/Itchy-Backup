<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- ── Glass Dark Palette ─────────────────────────────────────────────── -->
  <SolidColorBrush x:Key="BgPrimary"      Color="#07110D"/>
  <SolidColorBrush x:Key="BgSecondary"    Color="#081A14"/>
  <SolidColorBrush x:Key="BgTertiary"     Color="#0D241C"/>
  <SolidColorBrush x:Key="BgQuaternary"   Color="#123228"/>
  <LinearGradientBrush x:Key="BgCard" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#0D281F" Offset="0"/>
    <GradientStop Color="#061711" Offset="1"/>
  </LinearGradientBrush>

  <!-- ── Itchy Green Accent ─────────────────────────────────────────────── -->
  <SolidColorBrush x:Key="Accent"         Color="#007A4D"/>
  <SolidColorBrush x:Key="AccentLight"    Color="#00B875"/>
  <SolidColorBrush x:Key="AccentDark"     Color="#00462D"/>
  <SolidColorBrush x:Key="AccentGlow"     Color="#007A4D"/>
  <SolidColorBrush x:Key="AccentSubtle"   Color="#063323"/>
  <SolidColorBrush x:Key="AccentBright"   Color="#00D084"/>

  <!-- ── Neon Glow Colors ────────────────────────────────────────────────── -->
  <SolidColorBrush x:Key="NeonPurple"     Color="#00C47A"/>
  <SolidColorBrush x:Key="NeonCyan"       Color="#00FFE7"/>
  <Color x:Key="NeonPurpleColor"          >#00C47A</Color>
  <Color x:Key="NeonCyanColor"            >#00FFE7</Color>

  <!-- ── Semantic Colors ────────────────────────────────────────────────── -->
  <SolidColorBrush x:Key="Success"        Color="#00CEC9"/>
  <SolidColorBrush x:Key="Warning"        Color="#FDCB6E"/>
  <SolidColorBrush x:Key="Danger"         Color="#FF7675"/>
  <SolidColorBrush x:Key="Info"           Color="#74B9FF"/>

  <!-- ── Text ───────────────────────────────────────────────────────────── -->
  <SolidColorBrush x:Key="TextPrimary"    Color="#E8E8F0"/>
  <SolidColorBrush x:Key="TextSecondary"  Color="#9898B0"/>
  <SolidColorBrush x:Key="TextTertiary"   Color="#5A5A72"/>
  <SolidColorBrush x:Key="TextMuted"      Color="#3A3A50"/>

  <!-- ── Borders ────────────────────────────────────────────────────────── -->
  <SolidColorBrush x:Key="BorderBrush"        Color="#123B2C"/>
  <SolidColorBrush x:Key="BorderHoverBrush"   Color="#176044"/>

  <!-- ── Glass Effects ─────────────────────────────────────────────────── -->
  <SolidColorBrush x:Key="GlassBorder"        Color="#22FFFFFF"/>
  <SolidColorBrush x:Key="GlassHighlight"     Color="#12FFFFFF"/>
  <SolidColorBrush x:Key="GlassSurface"       Color="#08FFFFFF"/>

  <!-- ── Category Accent Colors ────────────────────────────────────────── -->
  <SolidColorBrush x:Key="CatUserFolders"  Color="#007A4D"/>
  <SolidColorBrush x:Key="CatBrowsers"     Color="#00CEC9"/>
  <SolidColorBrush x:Key="CatOutlook"      Color="#0078D4"/>
  <SolidColorBrush x:Key="CatDatabases"    Color="#FDCB6E"/>
  <SolidColorBrush x:Key="CatVMs"          Color="#FF7675"/>
  <SolidColorBrush x:Key="CatCloud"        Color="#55EFC4"/>
  <SolidColorBrush x:Key="CatCustom"       Color="#E17055"/>

  <!-- ── Progress Fill (ThemeService bu kaynağı accent rengine göre günceller) ── -->
  <LinearGradientBrush x:Key="ProgressFillBrush" StartPoint="0,0" EndPoint="1,0">
    <GradientStop Color="#00462D" Offset="0"/>
    <GradientStop Color="#007A4D" Offset="0.6"/>
    <GradientStop Color="#00B875" Offset="1"/>
  </LinearGradientBrush>

  <!-- ── Runtime Theme Brushes (ThemeService bu kaynakları override eder) ── -->
  <LinearGradientBrush x:Key="WindowBgBrush" StartPoint="0,0" EndPoint="1,1">
    <GradientStop Color="#06120E" Offset="0"/>
    <GradientStop Color="#07110D" Offset="0.5"/>
    <GradientStop Color="#082018" Offset="1"/>
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="TitleBarBrush" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#0A1F18" Offset="0"/>
    <GradientStop Color="#081A14" Offset="1"/>
  </LinearGradientBrush>
  <SolidColorBrush x:Key="WindowBorderBrush" Color="#006B43"/>

</ResourceDictionary>
